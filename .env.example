# 仅供本地开发示例：把它复制为 .env.local（不要提交到仓库）

# OpenRouter（前端直连：仅适合本地/自用；部署到 GitHub Pages 会暴露 Key）
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=
# 可选：远端 embedding（如启用本地 KB 检索）
VITE_OPENROUTER_EMBEDDING_MODEL=

# 本地 KB 资源地址（默认读取 /kb/manifest.json 和 /kb/vectors.bin）
# VITE_KB_MANIFEST_URL=/kb/manifest.json
# VITE_KB_VECTORS_URL=/kb/vectors.bin

# VitePress（构建时可覆盖）
# VITEPRESS_BASE=/docs/
# VITEPRESS_APP_URL=http://localhost:5173/
